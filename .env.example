# 복사해서 .env로 만들고 값 채우기. .env는 절대 커밋하지 않습니다.

# GPU 모델 앱 (GPU 서버, 내부망 전용)
GPU_MOCK=true                     # true: GPU 없이 가짜 응답으로 개발 / false: 진짜 GPU 호출
GPU_URL=http://<GPU 내부 IP>:8080  # GPU 서버 내부 주소 (포트는 GPU_API_PORT와 맞춘다)
GPU_API_KEY=                      # GPU .env의 동일한 비밀값; 저장소에 입력하지 않기
SESSION_SECRET=                   # 실서버: 32자 이상 임의 비밀값, 쿠키 소유권 서명에 사용
SESSION_COOKIE_SECURE=false       # HTTPS 서비스는 true, 현재 사설망 HTTP 테스트는 false
GPU_TIMEOUT_S=120
MOCK_DELAY_S=0.6                  # 가짜 응답 지연 (진행률 화면 확인용)
MOCK_FIXTURE=../data/demo/mock_gpu.json

# 분석 수량 (테스트하며 조정)
MAX_PHOTOS=10
MAX_CANDIDATE_POSTS=100
MAX_SCREEN_CAPTIONS=50

# 임시 파일 (처리 후 삭제, 이탈 시 TTL 뒤 삭제, 재시작 시 전체 삭제)
TMP_DIR=/tmp/kkokkok
UPLOAD_TTL_MIN=30

# 상한값 (기엽님 테스트 후 확정)
MAX_ZIP_MB=300
MAX_UNZIPPED_MB=1500
MAX_ZIP_FILES=5000
MAX_PHOTO_MB=20
MAX_IMAGE_SIDE=2200
MAX_IMAGE_PIXELS=40000000
THUMB_SIDE=320

# React 빌드 결과 위치 (backend/ 기준)
FRONTEND_DIST=../frontend/dist
