MODEL_ID=Qwen/Qwen3.5-4B
LOAD_4BIT=false
PIPELINE_ORDER=ocr_first
MODEL_EDGE=2200
OCR_EDGE=2200
OCR_VERSION=PP-OCRv5
OCR_LANG=korean
OCR_DEVICE=cpu
OCR_WORKER_CMD=/path/to/ocr-venv/bin/python /path/to/api_server/ocr_worker.py
MAX_NEW_TOKENS=768
MAX_WAITING=4
MAX_UPLOAD_MB=25
MAX_PIXELS=40000000
ARTIFACT_TTL_HOURS=24
ARTIFACT_DIR=./artifacts
API_KEY=replace-with-a-long-random-secret
API_HOST=0.0.0.0
API_PORT=8080
